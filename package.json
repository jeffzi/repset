{
  "name": "repset",
  "version": "0.0.0",
  "private": true,
  "description": "",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "lefthook run check",
    "check:package": "npm run build && publint --strict && attw --pack . --profile esm-only",
    "check:security": "fallow security",
    "fix": "lefthook run check --command lint --command md --command fmt && fallow fix --yes --no-create-config",
    "prepare": "test -d .git && lefthook install || true",
    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^26.6.5",
    "@vitest/coverage-istanbul": "^5.0.0",
    "cspell": "^10.4.0",
    "fallow": "^3.36.0",
    "lefthook": "^2.2.2",
    "markdownlint-cli2": "^0.24.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "publint": "^0.3.25",
    "tsx": "^4.23.15",
    "typescript": "^7.0.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "markdownlint-cli2": {
      "js-yaml": "^5.2.2"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
